# Builds the working tree: cd pkgbuild && makepkg -si
pkgname=deadbeat
pkgver=0.2.0
pkgrel=1
pkgdesc='Catches your deadbeat jobs: a notification when a long job stalls, finishes or fails'
arch=('x86_64' 'aarch64')
url='https://github.com/TheMridul/deadbeat'
license=('MIT')
depends=('gcc-libs' 'glibc' 'libnotify' 'openssh' 'coreutils')
optdepends=('aws-cli-v2: watch EC2 instances and hosts behind SSM'
            'github-cli: watch branches that a loop pushes to'
            'xdg-terminal-exec: follow logs from the Omarchy bar panel')
makedepends=('cargo')
options=('!lto')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked
}

check() {
  cd "$startdir/.."
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --release --locked
}

package() {
  cd "$startdir/.."
  install -Dm755 "$srcdir/target/release/deadbeat" "$pkgdir/usr/bin/deadbeat"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/deadbeat.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/deadbeat.svg"
  install -Dm644 pkgbuild/deadbeat.service "$pkgdir/usr/lib/systemd/user/deadbeat.service"
  install -Dm644 pkgbuild/deadbeat.timer "$pkgdir/usr/lib/systemd/user/deadbeat.timer"
}
